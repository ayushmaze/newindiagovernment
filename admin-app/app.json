{
  "expo": {
    "name": "NIG Admin",
    "slug": "nig-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nigadmin",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#1a1a1a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.newindiagovernment.admin" },
    "android": {
      "package": "com.newindiagovernment.admin",
      "adaptiveIcon": { "backgroundColor": "#c81e1e" }
    },
    "plugins": ["expo-secure-store", "expo-notifications"],
    "extra": {
      "apiBase": "https://newindiagovernment.com"
    }
  }
}
