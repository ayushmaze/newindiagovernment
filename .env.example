# --- Payload ---
DATABASE_URI=postgres://payload:payload@db:5432/payload
PAYLOAD_SECRET=replace-with-64-char-random
PAYLOAD_PUBLIC_SERVER_URL=https://newindiagoverment.lndo.site

# --- Next ---
NEXT_PUBLIC_SITE_URL=https://newindiagoverment.lndo.site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VOTE_SALT=replace-with-32-char-random
REVALIDATE_SECRET=replace-with-32-char-random

# --- Mail (dev = Mailpit) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="The New India Government <noreply@newindiagoverment.lndo.site>"

# --- Seed ---
SEED_ADMIN_EMAIL=admin@thenewindiagov.test
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_COWORK_EMAIL=cowork@thenewindiagov.test

# --- Fact-check agent ---
# Option 1 (API path): server-side agent loop, billed per-token.
#   ANTHROPIC_API_KEY=sk-ant-...
#   UNSPLASH_ACCESS_KEY=...                  # optional, hero images
# Option 2 (Claude Code path): used by /factcheck slash command.
#   Set to any random string; the slash command reads it from this file
#   and passes it back in the X-Ingest-Secret header when POSTing drafts.
FACT_CHECK_INGEST_SECRET=replace-with-32-char-random
